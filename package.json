{
  "name": "ruruma",
  "version": "1.0.0",
  "private": true,
  "description": "Ruruma AI engineering brand website and browser-local project brief tool.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project jsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node scripts/check.mjs",
    "check:mermaid": "node scripts/mermaid-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:site && npm run check:mermaid"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "mermaid": "12.2.0",
    "typescript": "7.0.2"
  }
}
